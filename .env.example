# JagX Passport — environment configuration
# By JagX and JRILICENSE
#
# Copy to .env and adjust. Every value has a working default, so the
# engine runs with no configuration at all.

# Path to the SQLite store. Holds private keys — back it up, never commit it.
JAGX_PASSPORT_DB=jagx_passport.db

# Comma-separated list of origins allowed to call the API from a browser.
# Set this to your JagX Connect origin in production instead of '*'.
JAGX_PASSPORT_CORS=*
